# Vellora Environment Configuration Template
# Copy this file to .env or .env.local and populate with your own values.
# IMPORTANT: Never commit actual secret keys or .env files to GitHub.

# Application
VITE_APP_NAME="Vellora"
VITE_APP_URL="http://localhost:5173"

# Open Library API (Default public endpoint)
VITE_OPEN_LIBRARY_API_BASE="https://openlibrary.org"
VITE_COVERS_API_BASE="https://covers.openlibrary.org"

